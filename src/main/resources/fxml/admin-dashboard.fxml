<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.techpark.controller.AdminDashboardController"
      spacing="14.0" style="-fx-background-color: #fff7ed;">
    <padding>
        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0" />
    </padding>
    <children>
        <Label text="Dashboard de Administrador" style="-fx-font-size: 22px; -fx-font-weight: bold;" />
        <Button text="Simular Tormenta" onAction="#simulateStorm" />
        <Label fx:id="quickStatusLabel" text="Estado listo" />
        <TableView fx:id="attractionsTable" prefHeight="360.0">
            <columns>
                <TableColumn fx:id="nameColumn" text="Atraccion" prefWidth="220.0" />
                <TableColumn fx:id="statusColumn" text="Estado" prefWidth="140.0" />
                <TableColumn fx:id="visitorsColumn" text="Visitantes" prefWidth="120.0" />
                <TableColumn fx:id="waitTimeColumn" text="Espera" prefWidth="120.0" />
            </columns>
        </TableView>
        <HBox spacing="16.0">
            <children>
                <Label text="Ingresos totales:" />
                <Label fx:id="totalRevenueLabel" text="\$ 0.00" />
                <Label text="Mas visitada:" />
                <Label fx:id="mostVisitedLabel" text="Sin datos" />
            </children>
        </HBox>
    </children>
</VBox>
