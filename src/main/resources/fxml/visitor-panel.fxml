<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.techpark.controller.VisitorPanelController"
      spacing="12.0" style="-fx-background-color: #f8fafc;">
    <padding>
        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0" />
    </padding>
    <children>
        <Label text="Panel del Visitante" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
        <HBox spacing="12.0">
            <children>
                <Label text="Saldo:" />
                <Label fx:id="balanceLabel" text="\$ 0.00" />
                <Label text="Ticket:" />
                <Label fx:id="ticketTypeLabel" text="GENERAL" />
            </children>
        </HBox>
        <ComboBox fx:id="attractionSelector" promptText="Selecciona una atraccion" />
        <Button fx:id="joinQueueButton" text="Unirse a la Fila" onAction="#joinSelectedQueue" />
        <HBox spacing="12.0">
            <children>
                <Label text="Posicion actual:" />
                <Label fx:id="queuePositionLabel" text="-" />
            </children>
        </HBox>
        <Label fx:id="queueStatusLabel" text="Sin actividad en cola" />
        <Label text="Atracciones Favoritas" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
        <ListView fx:id="favoritesListView" prefHeight="200.0" />
    </children>
</VBox>
