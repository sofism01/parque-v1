<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.techpark.controller.GraphViewController">
    <children>
        <VBox spacing="10.0" AnchorPane.bottomAnchor="16.0" AnchorPane.leftAnchor="16.0"
              AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="16.0">
            <Label fx:id="pathStatusLabel" text="Selecciona dos atracciones para resaltar la ruta" />
            <Pane fx:id="canvas" prefHeight="560.0" prefWidth="880.0"
                  style="-fx-background-color: linear-gradient(to bottom, #eff6ff, #dbeafe); -fx-border-color: #bfdbfe; -fx-border-radius: 12; -fx-background-radius: 12;" />
        </VBox>
    </children>
</AnchorPane>
